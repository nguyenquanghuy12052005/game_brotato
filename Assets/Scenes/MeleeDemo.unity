  m_EditorClassIdentifier: Assembly-CSharp::MeleeSkillDemo
  demoCamera: {fileID: 311015924}
  skills:
  - title: "Khi\xEAn Ch\u1EAFn"
    group: "Giai \u0111o\u1EA1n 1"
    description: "M\xE0n ch\u1EAFn trong su\u1ED1t bao quanh nh\xE2n v\u1EADt v\xE0
      di chuy\u1EC3n c\xF9ng ng\u01B0\u1EDDi. D\xF9ng WASD \u0111\u1EC3 th\u1EED."
    prefab: {fileID: 7325029215757077668, guid: 380363568f8073c4ab1f97e1d82b1cee, type: 3}
  - title: "\u1EA2nh B\u1ED9"
    group: "Giai \u0111o\u1EA1n 1"
    description: "B\xF3ng m\u1EDD n\u1ED1i ti\u1EBFp tr\xEAn \u0111\u01B0\u1EDDng
      l\u01B0\u1EDBt."
    prefab: {fileID: 4580900802194355931, guid: 4398d226652e6e94e899ff8fa00f5f7d, type: 3}
  - title: "L\u01B0\u1EE1i \u0110ao H\u1ED9 Th\u1EC3"
    group: "Giai \u0111o\u1EA1n 1"
    description: "Hai l\u01B0\u1EE1i \u0111ao xoay quanh nh\xE2n v\u1EADt."
    prefab: {fileID: 3503932922071208952, guid: ca0f4596235dd9a4bb673c946c0299a0, type: 3}
  - title: "Tam Li\xEAn Th\u1EE9"
    group: "S\xE1t th\u1EE7 \xB7 N\u1ED9i t\u1EA1i"
    description: "Chu\u1ED7i \u0111\xE2m nhanh sau hai \u0111\xF2n tr\xFAng c\xF9ng
      m\u1EE5c ti\xEAu."
    prefab: {fileID: 4426280184805587325, guid: 167de27bc170fdb41bb61bd6f06bed3f, type: 3}
  - title: "\u1EA2nh H\u1ED3i K\xEDch"
    group: "S\xE1t th\u1EE7 \xB7 N\u1ED9i t\u1EA1i"
    description: "D\u01B0 \u1EA3nh \u0111\xE2m b\u1ED3i sau khi r\u1EDDi t\u1EA7m
      c\u1EADn chi\u1EBFn."
    prefab: {fileID: 4322056235814269681, guid: 8349c403bf3302244980328c5073193a, type: 3}
  - title: "\u1EA4n T\u1EED Huy\u1EC7t"
    group: "S\xE1t th\u1EE7 \xB7 N\u1ED9i t\u1EA1i"
    description: "D\u1EA5u t\u1EED huy\u1EC7t v\xE0 hi\u1EC7u \u1EE9ng ph\xE1 \u1EA5n."
    prefab: {fileID: 3136649950652378792, guid: a943a1b3734d4f645b12d0a6ae537ef0, type: 3}
  - title: "\u0110\u1ECBa Li\u1EC7t Tr\u1EA3m"
    group: "\u0110ao kh\xE1ch \xB7 N\u1ED9i t\u1EA1i"
    description: "Nh\xE1t b\u1ED5 m\u1EDF \u0111\u01B0\u1EDDng n\u1EE9t ch\u1EA1y
      v\u1EC1 ph\xEDa tr\u01B0\u1EDBc."
    prefab: {fileID: 7762745624449271562, guid: 6b5ff8d50da5bb846baeac963e5c9a3a, type: 3}
  - title: "Ho\xE0nh T\u1EA3o"
    group: "\u0110ao kh\xE1ch \xB7 N\u1ED9i t\u1EA1i"
    description: "C\xFA qu\xE9t v\xF2ng quanh th\xE2n khi \u0111\xE1nh tr\xFAng nhi\u1EC1u
      \u0111\u1ECBch."
    prefab: {fileID: 1048897219041938761, guid: a291c334b18dec14b8f8e73654e641c7, type: 3}
  - title: "Tr\u1ECDng \u0110ao"
    group: "\u0110ao kh\xE1ch \xB7 N\u1ED9i t\u1EA1i"
    description: "\xC1nh \u0111\u1ED3ng t\u1EE5 tr\xEAn v\u0169 kh\xED tr\u01B0\u1EDBc
      c\xFA b\u1ED5 m\u1EA1nh."
    prefab: {fileID: 3415002435192982038, guid: 7b6480e547f45bc4ca52340f6c0fe909, type: 3}
  - title: "H\u1ED3i Nguy\u1EC7t"
    group: "Ki\u1EBFm kh\xED \xB7 N\u1ED9i t\u1EA1i"
    description: "S\xF3ng ki\u1EBFm quay \u0111\u1EA7u v\xE0 tr\u1EDF v\u1EC1."
    prefab: {fileID: 8967249795029474702, guid: 33bf08d28faadc44d94c6ed86f16968b, type: 3}
  - title: "Ph\xE2n Quang"
    group: "Ki\u1EBFm kh\xED \xB7 N\u1ED9i t\u1EA1i"
    description: "Ba s\xF3ng ki\u1EBFm t\u1ECFa h\xECnh qu\u1EA1t."
    prefab: {fileID: 6245149714912166726, guid: 2aaa788e984789948813af6f5801e22c, type: 3}
  - title: "Ki\u1EBFm \u1EA4n"
    group: "Ki\u1EBFm kh\xED \xB7 N\u1ED9i t\u1EA1i"
    description: "Hai ki\u1EBFm \u1EA5n b\u1ECB ph\xE1 b\u1EB1ng nh\xE1t ch\xE9m
