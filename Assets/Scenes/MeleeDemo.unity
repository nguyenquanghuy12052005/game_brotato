    prefab: {fileID: 2840863550163719671, guid: b1025062a1757814f8fd0ce6d5b8d8af, type: 3}
  - title: "Thi\xEAn V\u1EABn Tr\u1EA3m"
    group: "L\xF5i cu\u1ED1i"
    description: "Gi\xE1ng xu\u1ED1ng r\u1ED3i qu\u1EA1t l\u1EEDa quanh t\xE2m."
